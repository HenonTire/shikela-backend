# =============================================================================
# Shikela Backend — Environment Variable Reference
# =============================================================================
# Copy to .env and fill in values:
#   Local (non-Docker):  cp .env.example .env
#   Docker development:  cp .env.docker .env
# =============================================================================

# -----------------------------------------------------------------------------
# Django core
# -----------------------------------------------------------------------------
DEBUG=true
DJANGO_SECRET_KEY=change-me-generate-a-long-random-secret-key
# Comma-separated hostnames. Required when DEBUG=false.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Comma-separated origins for CSRF (required behind HTTPS reverse proxy)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Host port mapped to the web container (docker-compose only)
DJANGO_PORT=8000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local development (PostgreSQL on host):
# DATABASE_URL=postgresql://shikela_user:shikela_password@127.0.0.1:5432/shikela_db
# Docker Compose (service name "db"):
DATABASE_URL=postgresql://shikela_user:shikela_password@127.0.0.1:5432/shikela_db

POSTGRES_DB=shikela_db
POSTGRES_USER=shikela_user
POSTGRES_PASSWORD=shikela_password
POSTGRES_PORT=5432

# Used by entrypoint.sh to wait for PostgreSQL (Docker: db)
DB_HOST=127.0.0.1
DB_PORT=5432

# Leave DATABASE_URL unset to use SQLite (db.sqlite3) for quick local testing.

# -----------------------------------------------------------------------------
# Redis / Celery
# -----------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@shikela.local
SERVER_EMAIL=no-reply@shikela.local

# Email verification
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_REQUIRED_FOR_LOGIN=true
# Public backend URL used in verification links (e.g. https://api.example.com)
EMAIL_VERIFICATION_BACKEND_BASE_URL=http://127.0.0.1:8000
# Frontend URL users land on after clicking verification link
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:3000/verify-email

# Optional notification toggles
EMAIL_SEND_ORDER_SHIPPED=false
EMAIL_SEND_ORDER_DELIVERED=false
EMAIL_SEND_URGENT_LOW_STOCK=true
EMAIL_SEND_OTHER_NOTIFICATION_TYPES=false

# -----------------------------------------------------------------------------
# SantimPay (payment gateway)
# -----------------------------------------------------------------------------
SANTIMPAY_TEST_BED=true
SANTIMPAY_MERCHANT_ID=
SANTIMPAY_PRIVATE_KEY=
SANTIMPAY_SIGN_TOKEN_URL=
SANTIMPAY_SUCCESS_REDIRECT_URL=http://127.0.0.1:8000/payment/success
SANTIMPAY_FAILURE_REDIRECT_URL=http://127.0.0.1:8000/payment/failure
SANTIMPAY_CANCEL_REDIRECT_URL=http://127.0.0.1:8000/payment/cancel
SANTIMPAY_NOTIFY_URL=http://127.0.0.1:8000/payment/webhook/santimpay/

# -----------------------------------------------------------------------------
# Platform payout accounts
# -----------------------------------------------------------------------------
PLATFORM_USER_ID=
PLATFORM_USER_EMAIL=
PLATFORM_MERCHANT_ID=

# -----------------------------------------------------------------------------
# Firebase Cloud Messaging (push notifications)
# -----------------------------------------------------------------------------
FCM_PROJECT_ID=
# Path to service account JSON file (relative to project root or absolute)
FCM_SERVICE_ACCOUNT_FILE=
# Alternatively, inline JSON (single line or escaped newlines)
FCM_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------------------------
# Manual / integration test helpers (not required at runtime)
# -----------------------------------------------------------------------------
# BASE_URL=http://127.0.0.1:8000
# ACCESS_TOKEN=
# ADMIN_ACCESS_TOKEN=
# SHOP_OWNER_ACCESS_TOKEN=
# SUPPLIER_ACCESS_TOKEN=
# ORDER_ID=
# PAYMENT_ID=
# REFUND_ID=
# REFUND_AMOUNT=0.10
# THEME_IMAGE_PATH=
