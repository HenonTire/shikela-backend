# =============================================================================
# Shikela Backend — Docker Compose environment
# =============================================================================
# Usage: cp .env.docker .env && docker compose up -d
# =============================================================================

# Django core
DEBUG=true
DJANGO_SECRET_KEY='yiv_uchahcn*=zssiw7!mg62@=z=rmorir$$$dg)6vaf3+xqzm4$$'
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web,nginx
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost

DJANGO_PORT=8000
NGINX_PORT=80

# PostgreSQL (docker-compose service: db)
POSTGRES_DB=shikela_db
POSTGRES_USER=shikela_user
POSTGRES_PASSWORD=shikela_password
POSTGRES_PORT=5432
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://shikela_user:shikela_password@db:5432/shikela_db

# Redis / Celery (docker-compose service: redis)
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email (console backend for local Docker)
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_REQUIRED_FOR_LOGIN=true
EMAIL_VERIFICATION_BACKEND_BASE_URL=http://localhost:8000
EMAIL_VERIFICATION_FRONTEND_URL=

# SantimPay (testnet defaults — override for real credentials)
SANTIMPAY_TEST_BED=true
SANTIMPAY_MERCHANT_ID=
SANTIMPAY_PRIVATE_KEY=
SANTIMPAY_SIGN_TOKEN_URL=
SANTIMPAY_SUCCESS_REDIRECT_URL=http://127.0.0.1:8000/payment/success
SANTIMPAY_FAILURE_REDIRECT_URL=http://127.0.0.1:8000/payment/failure
SANTIMPAY_CANCEL_REDIRECT_URL=http://127.0.0.1:8000/payment/cancel
SANTIMPAY_NOTIFY_URL=http://127.0.0.1:8000/payment/webhook/santimpay/

# Platform
PLATFORM_USER_ID=
PLATFORM_USER_EMAIL=
PLATFORM_MERCHANT_ID=

# FCM
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@shikela.local
SERVER_EMAIL=no-reply@shikela.local
